<%- include('partials/header', { pageTitle: id + ' — ' + title }) %>

<section class="paper-bg case-file">

  <a href="/" class="back">← Volver al expediente</a>

  <div class="stamp">
    <div class="stamp__label">FOLIO DE INVESTIGACIÓN</div>
    <div class="stamp__code"><%= id %></div>
    <div class="stamp__meta"><%= intro.motor.toUpperCase() %></div>
  </div>

  <h1><%= title %></h1>
  <p class="case-file__motor">Motor de evidencia: <%= intro.motor %></p>

  <% if (blockedBy) { %>
    <div class="case-file__blocked">
      <p><strong>Folio sellado.</strong> Para acceder a este expediente debes presentar antes el informe del folio <strong><%= blockedBy %></strong>.</p>
    </div>
  <% } else { %>

    <div class="case-file__section">
      <h3>Informe narrativo</h3>
      <div class="narrative">
        <%- intro.narrative_html %>
      </div>
    </div>

    <% if (intro.why_this_db_html) { %>
      <div class="case-file__section">
        <h3>Nota técnica del archivero</h3>
        <details class="why-db" open>
          <summary>💡 ¿Por qué este motor para estos datos?</summary>
          <div class="why-db-content">
            <%- intro.why_this_db_html %>
          </div>
        </details>
      </div>
    <% } %>

    <div class="case-file__section">
      <h3>Acceso al sistema</h3>
      <div class="links">
        <a class="btn" href="<%= intro.ui_url %>" target="_blank" rel="noopener">Abrir <%= intro.ui_label %> ↗</a>
        <a class="btn btn--ghost" href="/cheatsheet/<%= intro.cheatsheet %>" target="_blank">Cheatsheet <%= intro.cheatsheet %> 📖</a>
      </div>
    </div>

    <div class="case-file__section">
      <h3>Notas del investigador (pistas progresivas)</h3>
      <p class="muted">Las consultas a archivo se registran en tu expediente personal pero no descuentan puntos. Úsalas si te atoras.</p>
      <div class="hint-buttons">
        <button data-level="1">Pista 1 (suave)</button>
        <button data-level="2">Pista 2 (media)</button>
        <button data-level="3">Pista 3 (fuerte)</button>
      </div>
      <div id="hint-out" class="hint-out"></div>
    </div>

    <% if (showVectorWidget) { %>
      <div class="case-file__section">
        <h3>Búsqueda semántica en archivo de testimonios</h3>
        <div class="vector-widget">
          <p class="muted">Pega la frase del testimonio anónimo encontrado en Redis. El sistema genera el embedding y consulta la colección <code>witness_testimonies</code> en Qdrant.</p>
          <textarea id="vector-query" rows="4" placeholder="Pega aquí la frase del testimonio..."></textarea>
          <button id="vector-search">Buscar testimonios similares</button>
          <div id="vector-out"></div>
        </div>
      </div>
    <% } %>

    <div class="submit-box">
      <h3>▶ Informe oficial del folio <%= id %></h3>
      <input type="text" id="answer" placeholder="Escribe tu respuesta y presiona Validar" />
      <button id="check">Validar informe</button>
      <p id="check-result"></p>
    </div>
  <% } %>
</section>

<script>
  const stationId = "<%= id %>";

  function renderMarkdownish(text) {
    return text
      .replace(/```([\s\S]*?)```/g, (m, code) => `<pre><code>${code.replace(/</g,'&lt;')}</code></pre>`)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\n/g, '<br>');
  }

  document.querySelectorAll('.hint-buttons button').forEach(btn => {
    btn.addEventListener('click', async () => {
      const level = btn.dataset.level;
      const r = await fetch(`/hints/${stationId}/${level}`);
      const j = await r.json();
      const out = document.getElementById('hint-out');
      const div = document.createElement('div');
      div.className = 'hint hint--' + level;
      div.innerHTML = `<strong>Pista ${level}:</strong> ${renderMarkdownish(j.content || j.error)}`;
      out.appendChild(div);
    });
  });

  document.getElementById('check').addEventListener('click', async () => {
    const answer = document.getElementById('answer').value;
    const r = await fetch(`/station/${stationId}/check`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ answer })
    });
    const j = await r.json();
    const el = document.getElementById('check-result');
    if (j.ok) {
      el.innerHTML = '✓ Informe aceptado — folio cerrado. <a href="/">Volver al expediente</a> para abrir el siguiente.';
      el.className = 'ok';
    } else {
      el.innerHTML = '✗ ' + j.error;
      el.className = 'fail';
    }
  });

  const vsBtn = document.getElementById('vector-search');
  if (vsBtn) {
    vsBtn.addEventListener('click', async () => {
      const query = document.getElementById('vector-query').value;
      if (!query.trim()) return;
      const out = document.getElementById('vector-out');
      out.innerHTML = '<em>Generando embedding y consultando Qdrant... (~5s la primera vez)</em>';
      const r = await fetch('/search-vectors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, top: 3 })
      });
      const j = await r.json();
      if (j.error) { out.innerHTML = '✗ Error: ' + j.error; return; }
      out.innerHTML = '<h4>Top 3 testimonios:</h4>' + j.top.map((t, i) =>
        `<div class="testimony"><strong>#${i+1} · score ${t.score.toFixed(4)}</strong><br>${t.text}</div>`
      ).join('');
    });
  }
</script>

<%- include('partials/footer') %>
