<%- include('partials/header', { pageTitle: id + ' — ' + title }) %>

<section class="paper-bg case-file">

  <a href="/" class="back">← Volver al expediente</a>

  <div class="stamp">
    <div class="stamp__label">FOLIO DE INVESTIGACIÓN</div>
    <div class="stamp__code"><%= id %></div>
    <div class="stamp__meta"><%= intro.motor.toUpperCase() %></div>
  </div>

  <h1><%= title %></h1>
  <p class="case-file__motor">Motor de evidencia: <%= intro.motor %></p>

  <% if (blockedBy) { %>
    <div class="case-file__blocked">
      <p><strong>Folio sellado.</strong> Para acceder a este expediente debes presentar antes el informe del folio <strong><%= blockedBy %></strong>.</p>
    </div>
  <% } else { %>

    <div class="case-file__section">
      <h3>Informe narrativo</h3>
      <div class="narrative">
        <%- intro.narrative_html %>
      </div>
    </div>

    <% if (intro.why_this_db_html) { %>
      <div class="case-file__section">
        <h3>Nota técnica del archivero</h3>
        <details class="why-db" open>
          <summary>💡 ¿Por qué este motor para estos datos?</summary>
          <div class="why-db-content">
            <%- intro.why_this_db_html %>
          </div>
        </details>
      </div>
    <% } %>

    <div class="case-file__section">
      <h3>Acceso al sistema</h3>
      <div class="links">
        <a class="btn" href="<%= intro.ui_url %>" target="_blank" rel="noopener">Abrir <%= intro.ui_label %> ↗</a>
        <a class="btn btn--ghost" href="/cheatsheet/<%= intro.cheatsheet %>" target="_blank">Cheatsheet <%= intro.cheatsheet %> 📖</a>
      </div>
    </div>

    <div class="case-file__section">
      <h3>Notas del archivo (pistas progresivas)</h3>
      <p class="muted">Las pistas se desbloquean por tiempo: Pista 1 a los <strong>5 min</strong>, Pista 2 a los <strong>10 min</strong>, Pista 3 a los <strong>15 min</strong> después de abrir este folio. Esto te incentiva a investigar primero.</p>
      <div class="hint-buttons" id="hint-buttons" data-opened-at="<%= openedAt %>">
        <button class="hint-btn" data-level="1" data-unlock="<%= HINT_UNLOCK_SECONDS[1] %>" disabled>Pista 1</button>
        <button class="hint-btn" data-level="2" data-unlock="<%= HINT_UNLOCK_SECONDS[2] %>" disabled>Pista 2</button>
        <button class="hint-btn" data-level="3" data-unlock="<%= HINT_UNLOCK_SECONDS[3] %>" disabled>Pista 3</button>
      </div>
    </div>

    <% if (showMongoShell) { %>
      <div class="case-file__section">
        <h3>Shell de MongoDB (acceso vía servicio sin auth)</h3>
        <div class="vector-widget">
          <p class="muted">El servicio MongoDB del campus no requiere autenticación — tienes shell access. Métodos permitidos: <code>find</code>, <code>findOne</code>, <code>countDocuments</code>, <code>aggregate</code>, <code>distinct</code>. Colecciones disponibles: <code>gym_members</code>, <code>social_posts</code>, <code>_evidence_archive</code>. Los resultados se limitan a 100 docs.</p>
          <p class="muted">Ejemplo: <code>db.gym_members.countDocuments({})</code></p>
          <textarea id="mongo-query" rows="3" placeholder="db.gym_members.find({...})"></textarea>
          <button id="mongo-run">Ejecutar query</button>
          <div id="mongo-out"></div>
        </div>
      </div>
    <% } %>

    <% if (showVectorWidget) { %>
      <div class="case-file__section">
        <h3>Búsqueda semántica en archivo de testimonios (hybrid search)</h3>
        <div class="vector-widget">
          <p class="muted">Qdrant permite combinar <strong>búsqueda vectorial</strong> (por significado) con <strong>filtros de payload</strong> (por metadatos estructurados). Pega la frase del testimonio anónimo y, si lo necesitas, restringe los resultados a una categoría específica.</p>
          <textarea id="vector-query" rows="4" placeholder="Pega aquí la frase del testimonio..."></textarea>
          <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin: 0.5rem 0;">
            <label style="font-family: Georgia, serif; font-size: 0.9rem;">
              Filtrar por categoría:
              <select id="vector-category" style="margin-left: 0.4rem; padding: 0.35rem 0.5rem; font-family: Georgia, serif;">
                <option value="all">(sin filtro · todas)</option>
                <option value="witness_account">witness_account</option>
                <option value="anonymous_tip">anonymous_tip</option>
                <option value="background_check">background_check</option>
                <option value="social_media_intel">social_media_intel</option>
              </select>
            </label>
            <button id="vector-search">Buscar testimonios similares</button>
          </div>
          <div id="vector-out"></div>
        </div>
      </div>
    <% } %>

    <% if (hasAttackSim) { %>
      <div class="case-file__section attack-prep" id="attack-prep">
        <h3>🛡️ Preparación defensiva — vulnerabilidad expuesta</h3>
        <div id="attack-prep-status" class="attack-prep__status attack-prep__status--idle">
          <strong>Estado:</strong> <span id="attack-prep-state-label">cargando…</span>
          <span id="attack-prep-countdown" class="attack-prep__countdown"></span>
        </div>
        <p class="muted attack-prep__intro" id="attack-prep-intro">
          Este motor (<strong><span id="attack-prep-motor"></span></strong>) está corriendo sin autenticación — exactamente como el campus lo tiene en producción. <strong>Un actor externo va a explotarlo</strong> dentro de los próximos minutos. Lee las 8 defensas abajo, entiende qué hace cada una, y cuando empiece el ataque tendrás <strong>90 segundos</strong> para aplicar las suficientes (necesitas combinar para llegar a <strong>5 puntos</strong>). Si fallas, los datos serán destruidos y tendrás que restaurar con costo de credibilidad.
        </p>
        <div class="attack-prep__score">
          <span>Score acumulado: <strong id="attack-prep-score">0</strong> / <span id="attack-prep-threshold">5</span></span>
          <div class="attack-prep__bar">
            <div id="attack-prep-bar-fill" class="attack-prep__bar-fill" style="width:0%"></div>
          </div>
        </div>
        <div id="attack-defenses-inline" class="attack-defenses-grid">
          <p class="muted" style="grid-column:1/-1; padding:1rem; text-align:center;">Cargando catálogo de defensas…</p>
        </div>
      </div>
    <% } %>

    <div class="submit-box">
      <h3>▶ Informe oficial del folio <%= id %></h3>
      <input type="text" id="answer" placeholder="Escribe tu respuesta y presiona Validar" />
      <button id="check">Validar informe</button>
      <p id="check-result"></p>
    </div>
  <% } %>
</section>

<% if (hasAttackSim) { %>
<!-- Indicador de vigilancia (pending) — discreto, esquina inferior izquierda -->
<div id="attack-watchdog" class="attack-watchdog" hidden>
  <span class="attack-watchdog__icon">🛡️</span>
  <span class="attack-watchdog__text">
    SOC vigilando · <span id="attack-watchdog-time">--</span>s
  </span>
</div>

<!-- Banner sticky-top de ataque activo (countdown + log; defensas viven en el panel inline) -->
<div id="attack-banner" class="attack-banner" hidden>
  <div class="attack-banner__inner">
    <div class="attack-banner__head">
      <strong class="attack-banner__title">🚨 ATAQUE EN CURSO · <span id="attack-station-label"></span></strong>
      <span class="attack-banner__desc" id="attack-overlay-desc"></span>
    </div>
    <div class="attack-banner__timer">
      <span class="attack-banner__countdown"><span id="attack-countdown">90</span>s</span>
      <small>aplica defensas abajo · score <span id="attack-score-banner">0</span>/<span id="attack-threshold-banner">5</span></small>
    </div>
  </div>
  <pre class="attack-banner__log" id="attack-log"></pre>
</div>

<!-- Breach screen (failed) -->
<div id="breach-screen" class="breach-screen" hidden>
  <div class="breach-screen__inner">
    <h1>💀 BREACH</h1>
    <p class="breach-screen__motor" id="breach-motor"></p>
    <pre class="breach-screen__log" id="breach-log"></pre>
    <p class="breach-screen__cta">Los datos del motor fueron eliminados por el atacante. Para continuar la investigación tienes que <strong>restaurar desde backup</strong>, pero eso te costará 1 punto de credibilidad ante la fiscalía (no actuaste a tiempo).</p>
    <div class="breach-screen__actions">
      <button id="breach-restore" class="btn btn--primary">Restaurar desde backup (−1 credibilidad)</button>
    </div>
  </div>
</div>

<!-- Mini-modal con detalle de una defensa (al pulsarla, antes de aplicar) -->
<div id="defense-modal" class="hint-modal" hidden>
  <div class="hint-modal__overlay" data-defense-close></div>
  <div class="hint-modal__content" role="dialog" aria-modal="true">
    <div class="hint-modal__header">
      <h3 id="defense-modal-title">Defensa</h3>
      <button class="hint-modal__close" data-defense-close aria-label="Cerrar">×</button>
    </div>
    <div class="hint-modal__body">
      <p id="defense-modal-explanation"></p>
      <pre id="defense-modal-command" class="defense-modal__cmd"></pre>
      <p id="defense-modal-weight" class="defense-modal__weight"></p>
      <div class="defense-quiz" id="defense-quiz">
        <p class="defense-quiz__intro"><strong>Checkpoint:</strong> antes de aplicar, contesta. Si fallas, esta defensa queda <em>bloqueada</em> para este ataque (no penaliza credibilidad, solo pierdes la oportunidad de usarla).</p>
        <h4 id="defense-quiz-question" class="defense-quiz__q"></h4>
        <div id="defense-quiz-options" class="defense-quiz__opts"></div>
        <div id="defense-quiz-feedback" class="defense-quiz__feedback" hidden></div>
      </div>
      <div style="display:flex; gap:0.6rem; justify-content:flex-end; margin-top:1rem;">
        <button class="btn btn--ghost" data-defense-close type="button">Cerrar</button>
        <button class="btn btn--primary" id="defense-apply-btn" type="button" disabled>Aplicar esta defensa</button>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Modal de pistas -->
<div id="hint-modal" class="hint-modal" hidden>
  <div class="hint-modal__overlay" data-close></div>
  <div class="hint-modal__content" role="dialog" aria-modal="true" aria-labelledby="hint-modal-title">
    <div class="hint-modal__header">
      <h3 id="hint-modal-title">Pista</h3>
      <button class="hint-modal__close" data-close aria-label="Cerrar">×</button>
    </div>
    <div class="hint-modal__body no-copy" id="hint-modal-body" oncontextmenu="return false"></div>
  </div>
</div>

<script>
  const stationId = "<%= id %>";
  window.stationId = stationId;

  function renderMarkdownish(text) {
    return text
      .replace(/```([\s\S]*?)```/g, (m, code) => `<pre><code>${code.replace(/</g,'&lt;')}</code></pre>`)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\n/g, '<br>');
  }

  // ─── Hint timers ─────────────────────────────────────────────────
  const hintWrap = document.getElementById('hint-buttons');
  const openedAtRaw = hintWrap ? hintWrap.dataset.openedAt : null;
  const openedAtMs = openedAtRaw ? (function(s){
    if (!s) return Date.now();
    if (s.endsWith('Z') || s.includes('T')) return new Date(s).getTime();
    return new Date(s.replace(' ','T')+'Z').getTime();
  })(openedAtRaw) : null;

  function fmtCountdown(sec) {
    sec = Math.max(0, Math.ceil(sec));
    const m = Math.floor(sec/60), s = sec % 60;
    return m + ':' + String(s).padStart(2,'0');
  }

  function tickHintTimers() {
    if (!hintWrap || !openedAtMs) return;
    const elapsed = (Date.now() - openedAtMs) / 1000;
    document.querySelectorAll('.hint-btn').forEach(btn => {
      const need = parseInt(btn.dataset.unlock, 10);
      const remain = need - elapsed;
      const level = btn.dataset.level;
      if (remain <= 0) {
        btn.disabled = false;
        btn.textContent = 'Pista ' + level;
        btn.classList.add('hint-btn--unlocked');
      } else {
        btn.disabled = true;
        btn.textContent = 'Pista ' + level + ' · disponible en ' + fmtCountdown(remain);
      }
    });
  }
  if (hintWrap) {
    tickHintTimers();
    setInterval(tickHintTimers, 1000);
  }

  // ─── Modal de pistas ─────────────────────────────────────────────
  const hintModal = document.getElementById('hint-modal');
  const hintTitle = document.getElementById('hint-modal-title');
  const hintBody  = document.getElementById('hint-modal-body');
  function openHintModal() { hintModal.hidden = false; document.body.style.overflow = 'hidden'; }
  function closeHintModal() { hintModal.hidden = true; document.body.style.overflow = ''; }
  hintModal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeHintModal));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !hintModal.hidden) closeHintModal(); });

  document.querySelectorAll('.hint-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      const level = btn.dataset.level;
      hintTitle.textContent = 'Pista ' + level;
      hintBody.innerHTML = '<em>Cargando…</em>';
      openHintModal();
      const r = await fetch('/hints/' + stationId + '/' + level);
      const j = await r.json();
      if (r.status === 423) {
        hintBody.innerHTML = 'Pista bloqueada. Disponible en ' + fmtCountdown(j.remainingSec) + '.';
      } else {
        hintBody.innerHTML = renderMarkdownish(j.content || j.error || 'sin contenido');
      }
    });
  });

  // ─── Submit ─────────────────────────────────────────────────────
  const checkBtn = document.getElementById('check');
  if (checkBtn) {
    checkBtn.addEventListener('click', async () => {
      const answer = document.getElementById('answer').value;
      const r = await fetch('/station/' + stationId + '/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answer })
      });
      const j = await r.json();
      const el = document.getElementById('check-result');
      if (j.ok) {
        el.innerHTML = '✓ Informe aceptado — folio cerrado. <a href="/">Volver al expediente</a> para abrir el siguiente.';
        el.className = 'ok';
        if (typeof refreshHud === 'function') refreshHud();
      } else if (j.game_over) {
        el.innerHTML = '✗ Credibilidad agotada. <a href="/">Caso cerrado</a>.';
        el.className = 'fail';
        setTimeout(() => location.href = '/', 1500);
      } else {
        let msg = '✗ ' + (j.error || 'Respuesta incorrecta');
        if (typeof j.credibility === 'number') msg += ' · credibilidad restante: ' + j.credibility + '/5';
        el.innerHTML = msg;
        el.className = 'fail';
        if (typeof refreshHud === 'function') refreshHud();
      }
    });
  }

  // ─── MongoDB shell (E2) ─────────────────────────────────────────
  const mongoBtn = document.getElementById('mongo-run');
  if (mongoBtn) {
    function highlightJSON(text) {
      return text.replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/"([^"\\]*(?:\\.[^"\\]*)*)"(\s*:)/g, '<span style="color:#b8261c">"$1"</span>$2')
        .replace(/:\s*"([^"\\]*(?:\\.[^"\\]*)*)"/g, ': <span style="color:#2e7d32">"$1"</span>')
        .replace(/\b(true|false|null)\b/g, '<span style="color:#8b6f10">$1</span>')
        .replace(/(:\s*)(-?\d+(?:\.\d+)?)/g, '$1<span style="color:#8b6f10">$2</span>');
    }
    mongoBtn.addEventListener('click', async () => {
      const query = document.getElementById('mongo-query').value;
      if (!query.trim()) return;
      const out = document.getElementById('mongo-out');
      out.innerHTML = '<em>Ejecutando...</em>';
      const r = await fetch('/mongo-shell', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query })
      });
      const j = await r.json();
      if (!j.ok) { out.innerHTML = '<pre style="color:#b8261c">✗ ' + (j.error || 'error') + '</pre>'; return; }
      const meta = j.truncated
        ? `<p class="muted">Mostrando primeros ${j.count} resultados (truncado a 100).</p>`
        : `<p class="muted">${j.count} resultado${j.count===1?'':'s'}.</p>`;
      out.innerHTML = meta + '<pre>' + highlightJSON(JSON.stringify(j.result, null, 2)) + '</pre>';
    });
    document.getElementById('mongo-query').addEventListener('keydown', e => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') mongoBtn.click();
    });
  }

  // ─── Attack simulation (E2/E3) ──────────────────────────────────
  const hasAttackSim = <%= hasAttackSim ? 'true' : 'false' %>;
  const ATTACK_LABEL = { E2: 'MongoDB (sin auth)', E3: 'Redis (sin auth)' };
  const ATTACK_DESC = {
    E2: 'Un actor externo está enumerando colecciones de MongoDB. Aplica defensas hasta llegar al threshold antes de que se acabe el tiempo, o destruirá los datos.',
    E3: 'Un atacante en la red interna acaba de conectarse a Redis sin auth y está ejecutando KEYS *. Si llega a FLUSHALL, perderás todo el buffer de evidence:tip:*.'
  };
  const ATTACK_LOG_LINES = {
    E2: [
      '[09:14:22] tcp connect mongo:27017 from 198.51.100.7 — no auth required',
      '[09:14:22] > db.adminCommand({ listDatabases: 1 })',
      '[09:14:22] enumerating: admin, config, investigation',
      '[09:14:23] > use investigation',
      '[09:14:23] > db.getCollectionNames()',
      '[09:14:23] found: gym_members, social_posts, _evidence_archive',
      '[09:14:24] > db.gym_members.find({}).toArray() // exfiltrating...',
      '[09:14:25] [WARN] attacker may issue dropDatabase next',
    ],
    E3: [
      '[09:14:22] tcp connect redis:6379 from 198.51.100.7 — no auth required',
      '[09:14:22] > INFO server',
      '[09:14:22] redis_version:7.2.0 — protected-mode no',
      '[09:14:23] > KEYS *',
      '[09:14:23] enumerated 2847 keys (evidence:tip:*, gym:checkin:*, system:pipelines:*)',
      '[09:14:24] > MGET evidence:tip:20260315_1100_anon ...',
      '[09:14:25] [WARN] attacker may issue FLUSHALL next',
    ]
  };
  const BREACH_LOG = {
    E2: 'mongo > db.gym_members.drop() — true\nmongo > db.social_posts.drop() — true\nmongo > db._evidence_archive.drop() — true\n[DESTROYED] 3 colecciones eliminadas. RTO: pendiente.',
    E3: 'redis > DEL evidence:tip:* — 12 keys removed\nredis > DEL system:pipelines:* — 3 keys removed\n[DESTROYED] Buffer forense vacío. Cadena de custodia rota.\nRTO: pendiente.'
  };

  let attackPollTimer = null;
  let attackTickTimer = null;
  let attackLastFetch = 0;
  let attackState = null;
  let attackPendingSec = null;
  let attackActiveSec = null;
  let attackCatalogRendered = false;
  let attackLogTimer = null;
  let attackLogIndex = 0;
  let lastAppliedSet = [];

  function $(id) { return document.getElementById(id); }

  function paintWatchdog(secLeft) {
    const wd = $('attack-watchdog');
    if (!wd) return;
    wd.hidden = false;
    $('attack-watchdog-time').textContent = secLeft;
  }
  function hideWatchdog() { const wd = $('attack-watchdog'); if (wd) wd.hidden = true; }

  function paintBanner(status) {
    const banner = $('attack-banner');
    if (!banner) return;
    banner.hidden = false;
    document.body.classList.add('attack-active');
    $('attack-station-label').textContent = ATTACK_LABEL[stationId] || stationId;
    $('attack-overlay-desc').textContent = ATTACK_DESC[stationId] || '';
    $('attack-threshold-banner').textContent = status.threshold;
    $('attack-score-banner').textContent = status.score;
    if (!attackLogTimer) startAttackLog();
  }
  function hideBanner() {
    const banner = $('attack-banner');
    if (banner) banner.hidden = true;
    document.body.classList.remove('attack-active');
    stopAttackLog();
  }

  // Render del catálogo en el panel inline (siempre, desde el primer poll)
  function renderCatalogInline(catalog, applied, state, quizFailed) {
    const wrap = $('attack-defenses-inline');
    if (!wrap || !catalog) return;
    applied = applied || [];
    quizFailed = quizFailed || [];
    const clickable = state === 'active';
    wrap.innerHTML = catalog.map(d => {
      const isApp = applied.includes(d.id);
      const isQuizLocked = quizFailed.includes(d.id);
      const disabled = !clickable || isApp || isQuizLocked;
      let footer = '';
      if (isApp) footer = '';
      else if (isQuizLocked) footer = '<div class="defense-card__lock-msg defense-card__lock-msg--burned">🔥 quiz fallado · defensa quemada</div>';
      else if (!clickable) footer = '<div class="defense-card__lock-msg">🔒 disponible cuando empiece el ataque</div>';
      else footer = '<div class="defense-card__cta">▶ contestar y aplicar</div>';
      return `
      <button class="defense-card defense-card--${d.weight} ${isApp ? 'is-applied' : ''} ${isQuizLocked ? 'is-burned' : ''} ${clickable ? '' : 'is-locked'}" data-defense-id="${d.id}" ${disabled ? 'disabled' : ''}>
        <div class="defense-card__head">
          <span class="defense-card__weight defense-card__weight--${d.weight}">${d.weight} · ${d.points}pt</span>
          ${isApp ? '<span class="defense-card__check">✓ aplicada</span>' : ''}
          ${isQuizLocked ? '<span class="defense-card__burned-flag">✗ quemada</span>' : ''}
        </div>
        <div class="defense-card__label">${d.label}</div>
        <div class="defense-card__expl">${d.explanation}</div>
        <pre class="defense-card__cmd">${escapeHtml(d.command)}</pre>
        ${footer}
      </button>
    `;
    }).join('');
    wrap.querySelectorAll('[data-defense-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const def = catalog.find(x => x.id === btn.dataset.defenseId);
        openDefenseModal(def);
      });
    });
  }

  function escapeHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function updateScoreBar(score, threshold) {
    // Banner (active) + inline panel
    const banner = $('attack-score-banner'); if (banner) banner.textContent = score;
    const prep = $('attack-prep-score');     if (prep) prep.textContent = score;
    const fill = $('attack-prep-bar-fill');
    if (fill) {
      const pct = Math.min(100, (score / threshold) * 100);
      fill.style.width = pct + '%';
      fill.classList.toggle('attack-prep__bar-fill--full', pct >= 100);
    }
  }

  function updatePrepStatus(state, secLeft) {
    const wrap = $('attack-prep-status');
    const label = $('attack-prep-state-label');
    const countdown = $('attack-prep-countdown');
    const motor = $('attack-prep-motor');
    if (motor) motor.textContent = ATTACK_LABEL[stationId] || stationId;
    if (!wrap) return;
    wrap.classList.remove('attack-prep__status--pending', 'attack-prep__status--active', 'attack-prep__status--defended', 'attack-prep__status--failed', 'attack-prep__status--restored', 'attack-prep__status--idle');
    if (!state) {
      wrap.classList.add('attack-prep__status--idle');
      label.textContent = 'Sin ataque agendado todavía';
      countdown.textContent = '';
      return;
    }
    wrap.classList.add('attack-prep__status--' + state);
    if (state === 'pending') {
      label.textContent = '⏳ Atacante acercándose';
      countdown.textContent = '— inicia en ~' + secLeft + 's';
    } else if (state === 'active') {
      label.textContent = '🚨 ATAQUE EN CURSO';
      countdown.textContent = '— quedan ' + secLeft + 's';
    } else if (state === 'defended') {
      label.textContent = '🛡️ Defendido';
      countdown.textContent = '— sistema asegurado';
    } else if (state === 'failed') {
      label.textContent = '💀 Breach';
      countdown.textContent = '— restaura desde backup';
    } else if (state === 'restored') {
      label.textContent = '♻️ Restaurado';
      countdown.textContent = '— −1 credibilidad';
    }
  }

  // mini-modal de defensa con quiz
  let modalCurrentDef = null;
  let modalSelectedOption = null;

  function openDefenseModal(def) {
    if (!def) return;
    modalCurrentDef = def;
    modalSelectedOption = null;
    $('defense-modal-title').textContent = def.label;
    $('defense-modal-explanation').textContent = def.explanation;
    $('defense-modal-command').textContent = def.command;
    $('defense-modal-weight').textContent = `Peso: ${def.weight} (${def.points} pt). ${def.weight === 'critical' ? 'Defensa crítica — sin ella las demás son débiles.' : def.weight === 'high' ? 'Defensa importante.' : def.weight === 'medium' ? 'Defensa complementaria.' : 'Defensa de detección / poco peso por sí sola.'}`;

    const quizWrap = $('defense-quiz');
    const fb = $('defense-quiz-feedback');
    fb.hidden = true;
    fb.textContent = '';
    fb.className = 'defense-quiz__feedback';

    if (def.quiz) {
      quizWrap.hidden = false;
      $('defense-quiz-question').textContent = def.quiz.question;
      const opts = $('defense-quiz-options');
      opts.innerHTML = def.quiz.options.map((text, i) => `
        <label class="defense-quiz__opt">
          <input type="radio" name="defense-quiz-opt" value="${i}">
          <span>${escapeHtml(text)}</span>
        </label>
      `).join('');
      opts.querySelectorAll('input[name="defense-quiz-opt"]').forEach(inp => {
        inp.addEventListener('change', () => {
          modalSelectedOption = parseInt(inp.value, 10);
          $('defense-apply-btn').disabled = false;
        });
      });
      $('defense-apply-btn').disabled = true;
      $('defense-apply-btn').textContent = 'Contestar y aplicar';
    } else {
      quizWrap.hidden = true;
      $('defense-apply-btn').disabled = false;
      $('defense-apply-btn').textContent = 'Aplicar esta defensa';
    }
    $('defense-modal').hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeDefenseModal() {
    $('defense-modal').hidden = true;
    document.body.style.overflow = '';
    modalCurrentDef = null;
    modalSelectedOption = null;
  }

  if (hasAttackSim) {
    $('defense-modal').querySelectorAll('[data-defense-close]').forEach(el =>
      el.addEventListener('click', closeDefenseModal));
    $('defense-apply-btn').addEventListener('click', async () => {
      if (!modalCurrentDef) return;
      const btn = $('defense-apply-btn');
      btn.disabled = true;
      btn.textContent = '⏳ Validando...';
      const body = { defenseId: modalCurrentDef.id };
      if (modalCurrentDef.quiz && modalSelectedOption != null) body.quizAnswer = modalSelectedOption;
      const r = await fetch('/attack/' + stationId + '/defend', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify(body)
      });
      const j = await r.json();
      if (j.ok) {
        // Correcto: cerrar modal, refrescar UI
        closeDefenseModal();
        fetchAttackStatus();
        if (j.state === 'defended') showDefended();
      } else if (j.quiz_wrong) {
        // Mostrar feedback in-modal con la respuesta correcta
        const fb = $('defense-quiz-feedback');
        fb.hidden = false;
        fb.className = 'defense-quiz__feedback defense-quiz__feedback--wrong';
        fb.innerHTML = `<strong>✗ Incorrecto.</strong> Esta defensa queda <em>bloqueada</em> para este ataque.<br><br><strong>La respuesta correcta era:</strong> «${escapeHtml(j.correct_text)}»<br><br><em>${escapeHtml(j.explanation || '')}</em>`;
        btn.textContent = 'Cerrar';
        btn.disabled = false;
        btn.onclick = () => { closeDefenseModal(); fetchAttackStatus(); btn.onclick = null; };
      } else {
        // Otro error
        const fb = $('defense-quiz-feedback');
        fb.hidden = false;
        fb.className = 'defense-quiz__feedback defense-quiz__feedback--wrong';
        fb.textContent = j.error || 'Error desconocido';
        btn.textContent = 'Cerrar';
        btn.disabled = false;
        btn.onclick = () => { closeDefenseModal(); btn.onclick = null; };
      }
    });
  }

  function showDefended() {
    hideOverlay();
    hideWatchdog();
    stopAttackLog();
    // banner verde de éxito
    const note = document.createElement('div');
    note.className = 'attack-defended-toast';
    note.innerHTML = '🛡️ <strong>Ataque mitigado.</strong> Tus defensas alcanzaron el threshold. La fiscalía registró tu respuesta. Puedes seguir investigando.';
    document.body.appendChild(note);
    setTimeout(() => note.remove(), 8000);
  }

  function showBreach() {
    hideOverlay();
    hideWatchdog();
    stopAttackLog();
    const bs = $('breach-screen');
    $('breach-motor').textContent = ATTACK_LABEL[stationId];
    $('breach-log').textContent = BREACH_LOG[stationId];
    bs.hidden = false;
    document.body.classList.add('breach-active');
  }
  function hideBreach() {
    $('breach-screen').hidden = true;
    document.body.classList.remove('breach-active');
  }
  if (hasAttackSim) {
    $('breach-restore').addEventListener('click', async () => {
      const btn = $('breach-restore');
      btn.disabled = true;
      btn.textContent = '⏳ Restaurando backup...';
      const r = await fetch('/attack/' + stationId + '/restore', { method: 'POST' });
      const j = await r.json();
      if (j.ok) {
        hideBreach();
        if (typeof refreshHud === 'function') refreshHud();
        if (j.game_over) {
          setTimeout(() => location.href = '/', 1200);
        }
      } else {
        btn.disabled = false;
        btn.textContent = 'Reintentar restaurar';
      }
    });
  }

  function startAttackLog() {
    if (attackLogTimer) return;
    const log = $('attack-log');
    if (!log) return;
    const lines = ATTACK_LOG_LINES[stationId] || [];
    attackLogIndex = 0;
    log.textContent = '';
    attackLogTimer = setInterval(() => {
      if (attackLogIndex >= lines.length) { clearInterval(attackLogTimer); attackLogTimer = null; return; }
      log.textContent += lines[attackLogIndex] + '\n';
      log.scrollTop = log.scrollHeight;
      attackLogIndex++;
    }, 1500);
  }
  function stopAttackLog() {
    if (attackLogTimer) { clearInterval(attackLogTimer); attackLogTimer = null; }
  }

  async function fetchAttackStatus() {
    try {
      const r = await fetch('/attack/' + stationId + '/status');
      const j = await r.json();
      attackLastFetch = Date.now();
      const prev = attackState;
      attackState = j.state;
      attackPendingSec = j.pendingSecLeft;
      attackActiveSec = j.activeSecLeft;
      paintAttackUI(j);
      if (prev !== 'defended' && j.state === 'defended') showDefended();
      if (prev !== 'failed' && j.state === 'failed') showBreach();
    } catch {}
  }

  function paintAttackUI(j) {
    if (!j || !j.state) {
      hideWatchdog(); hideBanner(); hideBreach();
      updatePrepStatus(null, 0);
      return;
    }
    // SIEMPRE renderizar el catálogo inline si vino con la respuesta.
    // Re-render solo cuando cambia algo (estado, defensas aplicadas o quemadas) — barato.
    if (j.catalog && j.catalog.length) {
      const signature = j.state + '|' + (j.defenses || []).slice().sort().join(',') + '|' + (j.quiz_failed || []).slice().sort().join(',');
      if (signature !== window._attackCatalogSig) {
        renderCatalogInline(j.catalog, j.defenses, j.state, j.quiz_failed);
        window._attackCatalogSig = signature;
        attackCatalogRendered = true;
      }
    }
    updateScoreBar(j.score || 0, j.threshold);

    if (j.state === 'pending') {
      paintWatchdog(j.pendingSecLeft);
      hideBanner();
      hideBreach();
      updatePrepStatus('pending', j.pendingSecLeft);
    } else if (j.state === 'active') {
      hideWatchdog();
      paintBanner(j);
      $('attack-countdown').textContent = j.activeSecLeft;
      updatePrepStatus('active', j.activeSecLeft);
    } else if (j.state === 'defended') {
      hideWatchdog();
      hideBanner();
      hideBreach();
      updatePrepStatus('defended', 0);
    } else if (j.state === 'failed') {
      hideWatchdog();
      hideBanner();
      showBreach();
      updatePrepStatus('failed', 0);
    } else if (j.state === 'restored') {
      hideWatchdog();
      hideBanner();
      hideBreach();
      updatePrepStatus('restored', 0);
    }
  }

  function tickAttack() {
    if (!attackState) return;
    const delta = Math.floor((Date.now() - attackLastFetch) / 1000);
    if (attackState === 'pending' && attackPendingSec != null) {
      const left = Math.max(0, attackPendingSec - delta);
      $('attack-watchdog-time').textContent = left;
    } else if (attackState === 'active' && attackActiveSec != null) {
      const left = Math.max(0, attackActiveSec - delta);
      const el = $('attack-countdown');
      if (el) el.textContent = left;
    }
  }

  if (hasAttackSim) {
    // Defensa contra estado stale: ocultar breach-screen explícitamente al cargar.
    // El attribute `hidden` ya está en el DOM, pero por si CSS lo override o JS de sesión previa lo dejó visible.
    hideBreach();
    hideBanner();
    hideWatchdog();
    fetchAttackStatus();
    attackPollTimer = setInterval(fetchAttackStatus, 4000);
    attackTickTimer = setInterval(tickAttack, 1000);
  }

  // ─── Vector search (E4) ─────────────────────────────────────────
  const vsBtn = document.getElementById('vector-search');
  if (vsBtn) {
    vsBtn.addEventListener('click', async () => {
      const query = document.getElementById('vector-query').value;
      if (!query.trim()) return;
      const category = document.getElementById('vector-category').value;
      const out = document.getElementById('vector-out');
      out.innerHTML = '<em>Generando embedding y consultando Qdrant... (~5s la primera vez)</em>';
      const r = await fetch('/search-vectors', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, top: 5, category })
      });
      const j = await r.json();
      if (j.error) { out.innerHTML = '✗ Error: ' + j.error; return; }
      const filterLabel = j.filter ? `<span style="background:#b8261c;color:#f5f1e8;padding:0.1rem 0.5rem;border-radius:3px;font-size:0.8rem;">filtro: ${j.filter}</span>` : '<span class="muted" style="font-size:0.85rem;">sin filtro</span>';
      out.innerHTML = `<h4>Top ${j.top.length} testimonios · ${filterLabel}</h4>` + j.top.map((t, i) =>
        `<div class="testimony">
          <strong>#${i+1} · score ${t.score.toFixed(4)}</strong>
          <span style="background:rgba(0,0,0,0.06);padding:0.05rem 0.4rem;border-radius:3px;font-size:0.75rem;margin-left:0.5rem;">${t.category}</span>
          <br>${t.text}
        </div>`
      ).join('');
    });
  }
</script>

<%- include('partials/footer') %>
