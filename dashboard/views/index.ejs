<%- include('partials/header', { pageTitle: 'Inicio' }) %>

<section class="paper-bg">

  <div class="stamp">
    <div class="stamp__label">EXPEDIENTE DE INVESTIGACIÓN</div>
    <div class="stamp__code">CSI-2026-0315</div>
    <div class="stamp__meta">ITESM CAMPUS MONTERREY · CASO ACTIVO</div>
  </div>

  <h1 class="frontpage-headline">Crimen en el Laboratorio CETEC</h1>
  <p class="frontpage-subline">Investigador con evidencias distribuidas en 4 sistemas — Bases de datos relacional, documental, en memoria y vectorial.</p>

  <p class="frontpage-lead">
    Un investigador del ITESM Campus Monterrey fue encontrado sin vida la noche del 15 de marzo en el Laboratorio CETEC. El equipo de seguridad del campus distribuyó las evidencias del caso en <strong>cuatro motores de base de datos distintos</strong>. Tu trabajo: reunir las pistas correlacionándolas entre los cuatro y descubrir al asesino. Tienes <strong>60–80 minutos</strong>.
  </p>

  <div class="case-status-bar">
    <span><small>Tiempo (desde E1)</small><strong><%= elapsed %> min</strong></span>
    <span><small>Credibilidad</small><strong><%= player?.credibility ?? 5 %>/5 ❤</strong></span>
    <span><small>Pistas usadas</small><strong><%= hints %></strong></span>
    <span><small>Progreso</small><strong><%= completedCount %>/4 estaciones</strong></span>
    <span><small>Estado</small><strong><%= canSolve ? 'Listo para cerrar' : 'En curso' %></strong></span>
  </div>

  <div class="frontpage-cta">
    <a href="/caso">📰 Lee primero el expediente público del caso →</a>
    <span class="muted">Contexto narrativo, lugares y personajes. No revela respuestas.</span>
  </div>

  <h2>Estaciones de la investigación</h2>

  <div class="stations-paper">

    <div class="file-card file-card--walkthrough">
      <span class="file-card__tab">FOLIO E0 · TUTORIAL</span>
      <h3 class="file-card__title">Walkthrough — Lee primero</h3>
      <p class="file-card__meta">Ejemplo resuelto · 5 minutos</p>
      <p class="file-card__desc">Recorrido guiado por Adminer y la primera tabla del caso. Te calibra para resolver las demás estaciones sin atorarte con la mecánica.</p>
      <a class="btn" href="/walkthrough">Abrir walkthrough →</a>
    </div>

    <% stations.forEach((s) => { %>
      <div class="file-card <%= s.completed ? 'file-card--done' : '' %>">
        <span class="file-card__tab">FOLIO <%= s.id %></span>
        <h3 class="file-card__title">
          <%= s.title %>
          <% if (s.completed) { %><span class="file-card__badge">✓ Resuelta</span><% } %>
        </h3>
        <p class="file-card__meta">Motor: <%= s.motor %></p>
        <p class="file-card__desc">
          <% if (s.id === 'E1') { %>Recupera las entrevistas de los 3 testigos identificados en el reporte y cruza descripciones físicas con la columna de notas para encontrar a los 2 sospechosos visibles.
          <% } else if (s.id === 'E2') { %>Confirma alibis en redes sociales y descubre, vía un filtro JSON sobre un campo array, al entrenador con motivo real para el crimen.
          <% } else if (s.id === 'E3') { %>El sistema del gimnasio guarda check-ins en memoria. Alguien dejó una clave fuera del patrón estándar con un testimonio anónimo crítico para el caso.
          <% } else if (s.id === 'E4') { %>Testimonios anónimos indexados como embeddings. Búsqueda por significado para identificar a quién señala el informante con el nombre completo.<% } %>
        </p>
        <a class="btn" href="/station/<%= s.id %>">Abrir folio →</a>
      </div>
    <% }) %>

    <div class="file-card file-card--final <%= canSolve ? '' : 'file-card--locked' %>">
      <span class="file-card__tab">★ RESOLUCIÓN OFICIAL</span>
      <h3 class="file-card__title">Cerrar el caso</h3>
      <% if (canSolve) { %>
        <p class="file-card__desc">Tienes la evidencia de los 4 motores. Presenta el informe final: asesino + arma + lugar.</p>
        <a class="btn btn--primary" href="/solve">Presentar informe final →</a>
      <% } else { %>
        <p class="file-card__desc">Bloqueado. Completa las 4 estaciones para habilitar la presentación del informe.</p>
      <% } %>
    </div>

  </div>

</section>

<%- include('partials/footer') %>
