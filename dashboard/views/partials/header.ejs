<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'CSI · DB Distribuidas' %></title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <a href="/" class="brand">🔎 CSI · DB DISTRIBUIDAS</a>
  <nav id="main-nav">
    <a href="/" data-path="/">Inicio</a>
    <a href="/caso" data-path="/caso">📰 Expediente</a>
    <a href="/walkthrough" data-path="/walkthrough">E0 Tutorial</a>
    <a href="/solve" data-path="/solve">Resolver caso</a>
    <span class="nav-sep" aria-hidden="true"></span>
    <a class="ext" href="http://localhost:8081" target="_blank" rel="noopener">Adminer</a>
    <a class="ext" href="http://localhost:8082" target="_blank" rel="noopener">mongo-express</a>
    <a class="ext" href="http://localhost:8083" target="_blank" rel="noopener">RedisInsight</a>
    <a class="ext" href="http://localhost:6333/dashboard" target="_blank" rel="noopener">Qdrant</a>
  </nav>
</header>

<div id="hud" class="hud">
  <span id="hud-cred" class="hud__chip hud__chip--cred" title="Credibilidad — cada submit incorrecto resta">❤ <span id="hud-cred-value">—</span>/5</span>
  <span id="hud-time" class="hud__chip hud__chip--time" title="Tiempo desde que abriste E1">⏱ <span id="hud-time-value">—</span></span>
  <span id="hud-prog" class="hud__chip hud__chip--prog" title="Estaciones completadas">📂 <span id="hud-prog-value">—</span>/4</span>

  <div id="hud-bomb" class="hud__bomb" title="Tiempo restante antes de que el asesino escape">
    <span class="hud__bomb-time"><span id="hud-bomb-value">--:--:--</span></span>
    <div class="hud__bomb-track">
      <div id="hud-bomb-fill" class="hud__bomb-fill"></div>
      <span id="hud-bomb-icon" class="hud__bomb-icon">💣</span>
    </div>
  </div>

  <button id="dev-accel" class="hud__chip hud__chip--dev" type="button" title="DEV: acelerar el tiempo en 5 minutos">⏩ DEV +5m</button>
  <button id="dev-attack-e2" class="hud__chip hud__chip--attack" type="button" hidden title="DEV: forzar ataque inmediato a MongoDB (E2)">⚠️ DEV E2</button>
  <button id="dev-attack-e3" class="hud__chip hud__chip--attack" type="button" hidden title="DEV: forzar ataque inmediato a Redis (E3)">⚠️ DEV E3</button>
  <button id="reset-game" class="hud__chip hud__chip--reset" type="button" title="Iniciar caso nuevo — pierdes tu progreso actual">🔄 Nuevo caso</button>
</div>

<!-- Modal de confirmación de reset -->
<div id="reset-modal" class="hint-modal" hidden>
  <div class="hint-modal__overlay" data-reset-close></div>
  <div class="hint-modal__content" role="dialog" aria-modal="true" aria-labelledby="reset-modal-title">
    <div class="hint-modal__header">
      <h3 id="reset-modal-title">Iniciar caso nuevo</h3>
      <button class="hint-modal__close" data-reset-close aria-label="Cerrar">×</button>
    </div>
    <div class="hint-modal__body">
      <p>Esta acción va a:</p>
      <ul style="line-height: 1.7; padding-left: 1.2rem;">
        <li>Generar un identificador de investigador nuevo</li>
        <li>Reiniciar el reloj de 2 horas</li>
        <li>Restablecer tu credibilidad a 5/5</li>
        <li>Borrar tu progreso de estaciones, pistas y notas del expediente actual</li>
      </ul>
      <p style="margin-top: 1rem;">Tu expediente actual quedará archivado en el sistema (el instructor puede auditarlo).</p>
      <p><strong>¿Confirmas el reset?</strong></p>
      <div style="display: flex; gap: 0.6rem; justify-content: flex-end; margin-top: 1.2rem;">
        <button class="btn btn--ghost" data-reset-close type="button">Cancelar</button>
        <button class="btn btn--primary" id="reset-confirm" type="button">Sí, iniciar caso nuevo</button>
      </div>
    </div>
  </div>
</div>

<button id="notes-toggle" class="notes-fab" type="button" title="Abrir cuaderno de notas" aria-label="Abrir cuaderno de notas">
  <span class="notes-fab__icon">📝</span>
  <span class="notes-fab__label">Notas</span>
</button>

<aside id="notes-drawer" class="notes-drawer" hidden>
  <div class="notes-drawer__overlay" data-notes-close></div>
  <div class="notes-drawer__panel">
    <div class="notes-drawer__header">
      <h3>📝 Cuaderno de notas</h3>
      <button class="notes-drawer__close" data-notes-close aria-label="Cerrar">×</button>
    </div>
    <form id="note-form" class="notes-drawer__form">
      <textarea id="note-input" rows="3" placeholder="Anota algo del caso (sospechosos, IDs, queries, deducciones)..." maxlength="2000"></textarea>
      <button type="submit">+ Agregar nota</button>
    </form>
    <ul id="notes-list" class="notes-drawer__list"></ul>
  </div>
</aside>

<script>
  // Marcar pestaña activa según la ruta
  (function() {
    const path = window.location.pathname;
    const links = document.querySelectorAll('#main-nav a[data-path]');
    let best = null, bestLen = -1;
    links.forEach(a => {
      const p = a.getAttribute('data-path');
      if ((p === '/' && path === '/') || (p !== '/' && (path === p || path.startsWith(p)))) {
        if (p.length > bestLen) { best = a; bestLen = p.length; }
      }
    });
    if (best) best.classList.add('active');
  })();

  // ─── HUD: estado del jugador con countdown smooth ─────────────────
  function fmtMS(s)  { if (s == null) return '—'; const m=Math.floor(s/60),ss=s%60; return m+':'+String(ss).padStart(2,'0'); }
  function fmtHMS(s) { if (s == null) return '--:--:--'; const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),ss=s%60; return [h,m,ss].map(x=>String(x).padStart(2,'0')).join(':'); }

  window.__hudState = null;
  window.__hudLastFetch = 0;

  async function refreshHud() {
    try {
      const j = await (await fetch('/state')).json();
      window.__hudState = j;
      window.__hudLastFetch = Date.now();
      applyHud(j);
      if (j.game_over && window.location.pathname !== '/' && !window.location.pathname.startsWith('/game-over')) {
        // Forzar redirect al index cuando ocurre game over (incluye timeout)
        setTimeout(() => location.href = '/', 800);
      }
    } catch {}
  }

  function applyHud(j) {
    const started = !!j.started;
    document.getElementById('hud-cred-value').textContent = j.credibility ?? '—';
    document.getElementById('hud-prog-value').textContent = j.completed?.length ?? 0;
    const credEl = document.getElementById('hud-cred');
    credEl.classList.toggle('hud__chip--low', (j.credibility ?? 5) <= 2 && !j.game_over);
    credEl.classList.toggle('hud__chip--dead', !!j.game_over);

    // Time chip + bomba + dev + nuevo caso: ocultos hasta que el juego inicie
    const timeChip = document.getElementById('hud-time');
    const bombWrap = document.getElementById('hud-bomb');
    const devBtn   = document.getElementById('dev-accel');
    const resetBtn = document.getElementById('reset-game');
    const devE2    = document.getElementById('dev-attack-e2');
    const devE3    = document.getElementById('dev-attack-e3');
    if (!started) {
      if (timeChip) timeChip.style.display = 'none';
      if (bombWrap) bombWrap.style.display = 'none';
      if (devBtn)   devBtn.style.display   = 'none';
      if (resetBtn) resetBtn.style.display = 'none';
      if (devE2)    devE2.hidden = true;
      if (devE3)    devE3.hidden = true;
      return;
    }
    if (timeChip) timeChip.style.display = '';
    if (bombWrap) bombWrap.style.display = '';
    if (devBtn)   devBtn.style.display   = '';
    if (resetBtn) resetBtn.style.display = '';
    // Mostrar DEV ataque solo cuando el ataque está agendado pero aún no activo (pending)
    if (devE2) devE2.hidden = (j.attacks?.E2 !== 'pending');
    if (devE3) devE3.hidden = (j.attacks?.E3 !== 'pending');

    document.getElementById('hud-time-value').textContent = fmtMS(j.elapsed_seconds);

    const bombVal = document.getElementById('hud-bomb-value');
    const bombFill = document.getElementById('hud-bomb-fill');
    const bombIcon = document.getElementById('hud-bomb-icon');
    if (bombVal && bombFill && bombIcon) {
      const total = j.deadline_total_seconds || 7200;
      const remain = Math.max(0, j.deadline_remaining_seconds ?? total);
      bombVal.textContent = fmtHMS(remain);
      const pct = (remain / total) * 100;
      bombFill.style.width = pct + '%';
      bombIcon.style.left = pct + '%';
      bombWrap.classList.toggle('hud__bomb--warn',    pct < 50 && pct >= 20);
      bombWrap.classList.toggle('hud__bomb--danger',  pct < 20 && pct > 0);
      bombWrap.classList.toggle('hud__bomb--exploded', pct === 0);
    }
  }

  // Tick local cada segundo para que el countdown se vea fluido entre polls
  function tickHud() {
    const j = window.__hudState;
    if (!j) return;
    if (j.game_over || j.case_solved_at) { applyHud(j); return; }
    const delta = Math.floor((Date.now() - window.__hudLastFetch) / 1000);
    if (j.deadline_started && j.deadline_remaining_seconds != null) {
      const proj = { ...j,
        elapsed_seconds: (j.elapsed_seconds ?? 0) + delta,
        deadline_remaining_seconds: Math.max(0, (j.deadline_remaining_seconds ?? 0) - delta)
      };
      applyHud(proj);
    } else {
      applyHud(j);
    }
  }

  refreshHud();
  setInterval(refreshHud, 5000);
  setInterval(tickHud, 1000);

  // ─── DEV: botón de aceleración ───────────────────────────────────
  document.getElementById('dev-accel').addEventListener('click', async () => {
    const r = await fetch('/dev/accelerate', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ seconds: 300 })
    });
    const j = await r.json();
    refreshHud();
    if (j.game_over) setTimeout(() => location.href = '/', 600);
  });

  // ─── DEV: forzar ataque inmediato (E2/E3) ────────────────────────
  function wireDevAttack(stationId) {
    const btn = document.getElementById('dev-attack-' + stationId.toLowerCase());
    if (!btn) return;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      await fetch('/dev/trigger-attack/' + stationId, { method: 'POST' });
      btn.disabled = false;
      // Si estás en la estación atacada, dispara el fetch del overlay
      if (typeof fetchAttackStatus === 'function' && window.stationId === stationId) {
        fetchAttackStatus();
      } else {
        // Si estás en otra ruta, navega a la estación para que veas el overlay
        if (window.location.pathname !== '/station/' + stationId) {
          location.href = '/station/' + stationId;
        }
      }
    });
  }
  wireDevAttack('E2');
  wireDevAttack('E3');

  // ─── Nuevo caso (reset con confirmación) ─────────────────────────
  const resetModal = document.getElementById('reset-modal');
  function openResetModal()  { resetModal.hidden = false; document.body.style.overflow = 'hidden'; }
  function closeResetModal() { resetModal.hidden = true;  document.body.style.overflow = ''; }
  resetModal.querySelectorAll('[data-reset-close]').forEach(el => el.addEventListener('click', closeResetModal));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !resetModal.hidden) closeResetModal(); });
  document.getElementById('reset-game').addEventListener('click', openResetModal);
  document.getElementById('reset-confirm').addEventListener('click', async () => {
    const btn = document.getElementById('reset-confirm');
    btn.disabled = true;
    btn.textContent = '⏳ Procesando...';
    const r = await fetch('/new-game', { method: 'POST' });
    const j = await r.json();
    if (j.ok) location.href = j.redirect || '/';
    else { btn.disabled = false; btn.textContent = 'Sí, iniciar caso nuevo'; }
  });

  // ─── Notes drawer ───────────────────────────────────────────────
  const drawer = document.getElementById('notes-drawer');
  document.getElementById('notes-toggle').addEventListener('click', () => { drawer.hidden = false; loadNotes(); });
  drawer.querySelectorAll('[data-notes-close]').forEach(el => el.addEventListener('click', () => drawer.hidden = true));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !drawer.hidden) drawer.hidden = true; });

  async function loadNotes() {
    const r = await fetch('/notes');
    const j = await r.json();
    const ul = document.getElementById('notes-list');
    if (!j.notes.length) {
      ul.innerHTML = '<li class="notes-empty">No tienes notas todavía. Anota lo que encuentres — IDs, queries, deducciones.</li>';
      return;
    }
    ul.innerHTML = j.notes.map(n => `
      <li class="note" data-id="${n.id}">
        <div class="note-content" contenteditable="false">${escapeHtml(n.content)}</div>
        <div class="note-actions">
          <small>${n.updated_at}</small>
          <button data-action="edit">✎</button>
          <button data-action="save" hidden>✓</button>
          <button data-action="cancel" hidden>✗</button>
          <button data-action="delete">🗑</button>
        </div>
      </li>
    `).join('');
  }
  function escapeHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  document.getElementById('note-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('note-input');
    const content = input.value.trim();
    if (!content) return;
    await fetch('/notes', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({content}) });
    input.value = '';
    loadNotes();
  });

  document.getElementById('notes-list').addEventListener('click', async (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    const li = e.target.closest('li.note');
    const id = li.dataset.id;
    const contentEl = li.querySelector('.note-content');
    const action = btn.dataset.action;
    if (action === 'edit') {
      contentEl.contentEditable = 'true';
      contentEl.focus();
      li.querySelector('[data-action="edit"]').hidden = true;
      li.querySelector('[data-action="save"]').hidden = false;
      li.querySelector('[data-action="cancel"]').hidden = false;
      li.dataset.original = contentEl.textContent;
    } else if (action === 'save') {
      const newContent = contentEl.textContent.trim();
      await fetch('/notes/' + id, { method:'PATCH', headers:{'Content-Type':'application/json'}, body: JSON.stringify({content: newContent}) });
      loadNotes();
    } else if (action === 'cancel') {
      contentEl.textContent = li.dataset.original || '';
      loadNotes();
    } else if (action === 'delete') {
      if (!confirm('¿Borrar esta nota?')) return;
      await fetch('/notes/' + id, { method: 'DELETE' });
      loadNotes();
    }
  });
</script>

<main>
