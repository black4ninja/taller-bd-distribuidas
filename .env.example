# Copia este archivo a `.env` antes de levantar el taller
# (los valores aqui son los defaults que usa docker-compose si no defines .env)

# PostgreSQL - credenciales débiles intencionales (el taller las expone)
POSTGRES_USER=pg
POSTGRES_PASSWORD=pg
POSTGRES_DB=investigation

# Secret para firmar la cookie de progreso del alumno
# (cambiarlo entre sesiones evita que progreso de un grupo sirva en otro)
SESSION_SECRET=cambia-este-secreto-en-clase

# Mongo y Redis se levantan SIN auth a propósito (estaciones E2 y E3).
# NO los configures con password — es parte del aprendizaje.
